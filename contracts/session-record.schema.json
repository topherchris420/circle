{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/session-record.schema.json",
  "title": "Session Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "provenance",
    "device_time_start_us",
    "device_time_end_us",
    "status_flags",
    "crc32c"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "$ref": "#/$defs/recordType"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "device_time_start_us": {
      "type": "integer",
      "minimum": 0
    },
    "device_time_end_us": {
      "type": "integer",
      "minimum": 0
    },
    "status_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "crc32c": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}$"
    },
    "stream_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "payload": {
      "description": "One aligned telemetry snapshot at device_time_start_us; multi-sample binary chunks are not defined by this JSON profile.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "number"}
    },
    "source_stream_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_sequence_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_id", "first_sequence", "last_sequence"],
        "properties": {
          "stream_id": {
            "type": "string",
            "minLength": 1
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "last_sequence": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_time_us": {
      "description": "Device time at which a decision or inference was made. Evidence used by the decision must have been available (held in memory) at or before this time.",
      "type": "integer",
      "minimum": 0
    },
    "input_cutoff_us": {
      "description": "Newest sample instant (device time) the decision or inference was permitted to use. Must not exceed decision_time_us.",
      "type": "integer",
      "minimum": 0
    },
    "actuation_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_chain": {
      "description": "Per-command execution evidence for an INTERVENTION. Each stage is a distinct recorded event: the command firmware issued, the electrical onset it caused, and the physical actuation an independent sensor observed. A stage is claimed only when its evidence id is present. None of these stages is evidence that physiology changed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_index", "command_id", "stage"],
        "properties": {
          "cue_index": {"type": "integer", "minimum": 0},
          "command_id": {"type": "string", "minLength": 1},
          "electrical_onset_id": {"type": "string", "minLength": 1},
          "physical_observation_id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "enum": ["COMMAND_ONLY", "ELECTRICAL_ONSET_OBSERVED", "PHYSICALLY_OBSERVED"]}
        }
      }
    },
    "dropped_first_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_last_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "cause": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": [
        "RAW_MEASURED",
        "DERIVED",
        "MODEL_INFERRED",
        "SIMULATED",
        "TEST",
        "INTERVENTION"
      ]
    },
    "recordType": {
      "type": "string",
      "enum": [
        "SESSION_HEADER",
        "STREAM_DESCRIPTOR",
        "SAMPLE_CHUNK",
        "EVENT",
        "CLOCK_MAPPING",
        "CONFIG_CHANGE",
        "GAP",
        "FAULT",
        "MODEL_RESULT",
        "INTERVENTION",
        "SESSION_TRAILER"
      ]
    }
  },
  "allOf": [
    {
      "if": {"required": ["record_type"], "properties": {"record_type": {"const": "SAMPLE_CHUNK"}}},
      "then": {"required": ["stream_id", "sequence", "payload"]}
    },
    {
      "if": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "const": "MODEL_INFERRED"
          }
        }
      },
      "then": {
        "required": ["source_stream_ids", "source_sequence_ranges", "model"]
      }
    },
    {
      "if": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "const": "INTERVENTION"
          }
        }
      },
      "then": {
        "required": ["decision_id", "actuation_evidence_ids"]
      }
    },
    {
      "if": {
        "required": ["record_type"],
        "properties": {
          "record_type": {
            "const": "GAP"
          }
        }
      },
      "then": {
        "required": ["dropped_first_sequence", "dropped_last_sequence", "cause"]
      }
    }
  ]
}
