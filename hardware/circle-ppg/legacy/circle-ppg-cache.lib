EESchema-LIBRARY Version 2.4
#encoding utf-8
# 1V8_LOW_NOISE_LDO
DEF 1V8_LOW_NOISE_LDO U 0 40 Y Y 1 F N
F0 "U" 0 350 50 H V C CNN
F1 "1V8_LOW_NOISE_LDO" 0 -350 50 H V C CNN
DRAW
S -350 300 350 -300 0 1 10 f
X A 1 -550 200 200 R 40 40 1 1 P
X B 2 -550 100 200 R 40 40 1 1 P
ENDDRAW
ENDDEF
